{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    ".": {
      "project": "scripts/**/*.ts",
      // dependency-cruiser loads swc to parse TypeScript, as TypeScript 7 has
      // no JavaScript API for it.
      "ignoreDependencies": ["@swc/core"]
    },
    "packages/resume": {
      "entry": [
        "pages/**/*.tsx",
        "wdio.shared.conf.ts",
        "wdio.headless.conf.ts",
        "test/specs/*.e2e.ts",
        "lib/scripts/*.ts"
      ],
      "project": "**/*.{ts,tsx,mjs}",
      "ignoreDependencies": [
        "@types/mocha",
        "@wdio/local-runner",
        "@wdio/spec-reporter"
      ]
    },
    "packages/website": {
      "entry": ["src/main.ts", "src/**/*.test.ts", "test/**/*.ts"],
      "ignoreDependencies": ["@wdio/local-runner"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    },
    "packages/experiment": {
      "entry": ["pages/**/*.tsx", "test/specs/*.e2e.ts", "**/*.test.tsx"],
      "project": ["**/*.{ts,tsx}"],
      "ignoreDependencies": ["@types/mocha", "@wdio/local-runner"]
    }
  }
}
