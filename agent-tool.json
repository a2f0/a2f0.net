{
  "schemaVersion": 1,
  "subject": {
    "maxLength": 100
  },
  "merge": {
    "requiredChecks": [
      {
        "name": "build",
        "workflow": "CI"
      }
    ],
    "requireStrictBaseFreshness": true
  },
  "pr": {
    "rejectClaudeBranding": true
  },
  "permissions": {
    "executables": {
      "biome": "local",
      "commitlint": "local",
      "knip": "local",
      "markdownlint-cli2": "local",
      "tsc": "local",
      "tsx": "exec",
      "wrangler": "release"
    }
  },
  "branch": {
    "types": [
      "feat",
      "fix",
      "docs",
      "style",
      "refactor",
      "perf",
      "test",
      "build",
      "ci",
      "chore",
      "revert"
    ],
    "exempt": ["main", "staging"],
    "maxLength": null
  },
  "hooks": {
    "files": [
      {
        "source": "scripts/git/hooks/commit-msg",
        "target": "commit-msg",
        "executable": true
      },
      {
        "source": "scripts/git/hooks/pre-commit",
        "target": "pre-commit",
        "executable": true
      },
      {
        "source": "scripts/git/hooks/pre-push",
        "target": "pre-push",
        "executable": true
      }
    ]
  },
  "commits": {
    "signatures": "present",
    "signatureHeaderFallback": true,
    "rejectCoauthors": true,
    "subjects": false
  },
  "images": {
    "targets": {
      "favicons": {
        "outputs": [
          { "path": "favicon.svg", "layers": [{ "source": "logo" }] },
          {
            "path": "favicon.ico",
            "sizes": [16, 32, 48],
            "layers": [{ "source": "logo" }]
          },
          {
            "path": "apple-touch-icon.png",
            "size": 180,
            "opaque": true,
            "layers": [
              { "fill": "#202020" },
              { "source": "logo", "scale": 0.8 }
            ]
          }
        ]
      },
      "og-image": {
        "outputs": [
          {
            "path": "og-image.png",
            "size": [1200, 630],
            "opaque": true,
            "layers": [
              { "fill": "#202020" },
              { "source": "logo", "scale": 0.5 }
            ]
          }
        ]
      },
      "drive-favicons": {
        "dir": "packages/drive/public",
        "outputs": [
          { "path": "favicon.svg", "layers": [{ "source": "drive" }] },
          {
            "path": "favicon.ico",
            "sizes": [16, 32, 48],
            "layers": [{ "source": "drive" }]
          },
          {
            "path": "apple-touch-icon.png",
            "size": 180,
            "opaque": true,
            "layers": [
              { "fill": "#191e27" },
              { "source": "drive", "scale": 0.8 }
            ]
          }
        ]
      },
      "drive-og-image": {
        "dir": "packages/drive/public",
        "outputs": [
          {
            "path": "og-image.png",
            "size": [1200, 630],
            "opaque": true,
            "layers": [
              { "fill": "#191e27" },
              { "source": "drive", "scale": 0.5 }
            ]
          }
        ]
      }
    }
  }
}
