{
  "schemaVersion": 1,
  "subject": {
    "maxLength": 100
  },
  "merge": {
    "requiredChecks": [
      {
        "name": "build",
        "workflow": "CI"
      }
    ],
    "requireStrictBaseFreshness": true
  },
  "pr": {
    "rejectClaudeBranding": true
  },
  "branch": {
    "types": [
      "feat",
      "fix",
      "docs",
      "style",
      "refactor",
      "perf",
      "test",
      "build",
      "ci",
      "chore",
      "revert"
    ],
    "exempt": ["main", "staging"],
    "maxLength": null
  },
  "hooks": {
    "files": [
      {
        "source": "scripts/git/hooks/commit-msg",
        "target": "commit-msg",
        "executable": true
      },
      {
        "source": "scripts/git/hooks/pre-commit",
        "target": "pre-commit",
        "executable": true
      },
      {
        "source": "scripts/git/hooks/pre-push",
        "target": "pre-push",
        "executable": true
      }
    ]
  },
  "commits": {
    "signatures": "present",
    "signatureHeaderFallback": true,
    "rejectCoauthors": true,
    "subjects": false
  }
}
