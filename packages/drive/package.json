{
  "name": "@a2f0/drive",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/DriveApp.tsx",
    "./styles.css": "./src/drive.css"
  },
  "scripts": {
    "copy-sdk": "bun scripts/build/copySdk.ts",
    "dev": "bun run copy-sdk && next dev --webpack -p 4004",
    "build": "bun run copy-sdk && next build --webpack",
    "start": "wrangler dev --port 4004 --local",
    "compile": "tsc",
    "unit": "bun test ./src && bun test ./test/host.test.ts && bun test ./test/DocumentPanelEditing.test.tsx",
    "test": "bun run build && start-server-and-test 'bun run start' http://localhost:4004 'bun run test:served'",
    "test:served": "wdio run wdio.conf.ts",
    "test:integration": "wdio run wdio.conf.ts --spec ./test/integration/connection.e2e.ts",
    "deploy": "bun run build && bun ../../scripts/deploy/deploy.ts drive",
    "preview": "bun run build && bun ../../scripts/deploy/deploy.ts drive --dry-run"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@tearleads/client-sdk": "0.1.90",
    "@tearleads/windowing": "0.2.18",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@types/bun": "1.4.3",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wdio/cli": "10.1.0",
    "@wdio/globals": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/mocha-framework": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "start-server-and-test": "3.0.13",
    "typescript": "7.0.2",
    "wrangler": "4.151.3"
  }
}
