{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "experiment",
  "compatibility_date": "2026-09-16",
  "workers_dev": false,
  "preview_urls": false,
  // Terraform owns the custom domain (experiment.a2f0.net).
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
