{
  "name": "@a2f0/experiment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-art": "cp ../website/public/a2f0.svg public/a2f0.svg",
    "dev": "bun run copy-art && next dev --webpack -p 4003",
    "build": "bun run copy-art && next build --webpack",
    "start": "wrangler dev --port 4003 --local",
    "compile": "tsc",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@a2f0/shared": "workspace:*",
    "@a2f0/website": "workspace:*",
    "@tearleads/windowing": "link:@tearleads/windowing",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "typescript": "7.0.2",
    "wrangler": "4.132.0"
  }
}
