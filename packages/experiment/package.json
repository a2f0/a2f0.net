{
  "name": "@a2f0/experiment",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "copy-art": "cp ../website/public/a2f0.svg public/a2f0.svg",
    "copy-skyline": "bun scripts/copySkyline.ts",
    "copy-dnbm": "bun scripts/copyDnbm.ts",
    "dev": "bun run copy-art && bun run copy-skyline && bun run copy-dnbm && next dev --webpack -p 4003",
    "build": "bun run copy-art && bun run copy-skyline && bun run copy-dnbm && next build --webpack",
    "start": "wrangler dev --port 4003 --local",
    "compile": "tsc",
    "unit": "bun test ./components ./mini-apps",
    "test": "bun run build && start-server-and-test 'bun run start' http://localhost:4003 'bun run test:served'",
    "test:served": "wdio run wdio.conf.ts",
    "deploy": "bun run build && bun ../../scripts/deploy.ts experiment",
    "preview": "bun run build && bun ../../scripts/deploy.ts experiment --dry-run"
  },
  "dependencies": {
    "@a2f0/dnbm": "0.4.5",
    "@a2f0/shared": "workspace:*",
    "@a2f0/skyline": "0.2.36",
    "@a2f0/website": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@tearleads/windowing": "0.2.18",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@types/bun": "1.4.3",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wdio/cli": "10.1.0",
    "@wdio/globals": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/mocha-framework": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "start-server-and-test": "3.0.13",
    "typescript": "7.0.2",
    "wrangler": "4.151.3"
  }
}
