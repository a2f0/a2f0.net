{
  "name": "@a2f0/experiment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-art": "cp ../website/public/a2f0.svg public/a2f0.svg",
    "dev": "bun run copy-art && next dev --webpack -p 4003",
    "build": "bun run copy-art && next build --webpack",
    "start": "wrangler dev --port 4003 --local",
    "compile": "tsc",
    "test": "bun run build && start-server-and-test 'bun run start' http://localhost:4003 'bun run test:served'",
    "test:served": "wdio run wdio.conf.ts",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@a2f0/shared": "workspace:*",
    "@a2f0/website": "workspace:*",
    "@tearleads/windowing": "0.1.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "start-server-and-test": "3.0.12",
    "typescript": "7.0.2",
    "wrangler": "4.132.0"
  }
}
