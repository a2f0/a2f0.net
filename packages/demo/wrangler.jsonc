{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "demo",
  "compatibility_date": "2026-09-16",
  "workers_dev": false,
  "preview_urls": false,
  // Terraform owns the custom domain (demo.a2f0.net).
  // Bundles src/ and copies public/ into dist/ before dev and deploy.
  "build": {
    "command": "bun run build",
    "watch_dir": ["src", "public"]
  },
  "assets": {
    "directory": "./dist"
  }
}
