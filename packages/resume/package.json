{
  "name": "@resume/site",
  "version": "0.1.156",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "start-server": "next dev -p 4000",
    "start-server-test": "wrangler dev --env staging --port 4001 --local",
    "test": "wdio run wdio.shared.conf.ts",
    "test-headless": "wdio run wdio.headless.conf.ts",
    "ci": "bun run build && start-server-and-test 'bun run start-server-test' http-get://localhost:4001 'bun run test'",
    "ci-headless": "bun run build && start-server-and-test 'bun run start-server-test' http-get://localhost:4001 'bun run test-headless'",
    "build": "bun run generate:desktop-svg && next build",
    "generate:desktop-svg": "node --import tsx scripts/build/generateDesktopSvg.ts",
    "start": "wrangler dev --env staging --port 4000 --local",
    "compile": "tsc",
    "unit": "vitest run",
    "deploy:staging": "bun run build && bun ../../scripts/deploy/deploy.ts resume-staging",
    "deploy:prod": "bun run build && bun ../../scripts/deploy/deploy.ts resume-prod",
    "preview:staging": "bun run build && bun ../../scripts/deploy/deploy.ts resume-staging --dry-run",
    "preview:prod": "bun run build && bun ../../scripts/deploy/deploy.ts resume-prod --dry-run"
  },
  "dependencies": {
    "@a2f0/ct-client": "0.1.5",
    "@a2f0/shared": "workspace:*",
    "@next/third-parties": "16.4.2",
    "@phosphor-icons/react": "2.1.10",
    "@reduxjs/toolkit": "2.13.0",
    "color": "5.0.3",
    "invariant": "2.2.4",
    "next": "16.4.2",
    "pdfobject": "2.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.0",
    "redux": "5.0.1",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/invariant": "2.2.37",
    "@types/jsdom": "30.0.0",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/pdfobject": "2.2.5",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@wdio/cli": "10.1.0",
    "@wdio/globals": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/mocha-framework": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "ajv": "8.20.0",
    "axe-core": "4.14.0",
    "canvas": "3.2.3",
    "jsdom": "30.1.3",
    "start-server-and-test": "3.0.13",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  }
}
