{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "resume-redirect",
  "compatibility_date": "2026-09-16",
  "workers_dev": false,
  "preview_urls": false,
  // Keep the existing Worker name so its apex custom domain (a2f0.net), which
  // Terraform owns, stays attached.
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    // The routed shell's routes (/app/<app id>) load the one page.
    "not_found_handling": "single-page-application"
  }
}
