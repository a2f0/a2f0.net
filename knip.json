{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "exports": "off",
    "types": "off"
  },
  "workspaces": {
    ".": {
      "project": "scripts/**/*.ts"
    },
    "packages/resume": {
      "entry": [
        "pages/**/*.tsx",
        "wdio.shared.conf.ts",
        "wdio.headless.conf.ts",
        "test/specs/*.e2e.ts",
        "lib/scripts/*.ts"
      ],
      "project": "**/*.{ts,tsx,mjs}",
      "ignoreDependencies": [
        "@types/mocha",
        "@wdio/local-runner",
        "@wdio/spec-reporter"
      ]
    },
    "packages/agent-tool": {
      "project": ["src/**/*.ts"]
    },
    "packages/website": {
      "entry": ["src/main.ts", "src/**/*.test.ts", "test/**/*.ts"],
      "ignoreDependencies": ["@wdio/local-runner"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    },
    "packages/experiment": {
      "entry": ["pages/**/*.tsx", "test/specs/*.e2e.ts"],
      "project": ["**/*.{ts,tsx}"],
      "ignoreDependencies": ["@types/mocha", "@wdio/local-runner"]
    }
  }
}
