{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "compile": {
      "dependsOn": ["transit"]
    },
    "unit": {
      "dependsOn": ["transit"]
    },
    "build": {
      "dependsOn": ["transit"],
      "env": ["NEXT_PUBLIC_TEARLEADS_API_URL", "RESUME_DEPLOY_TIER"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/agent-tool.json",
        "$TURBO_ROOT$/assets/brand/**"
      ],
      "outputs": [
        ".generated/**",
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "out/**",
        "public/a2f0.svg",
        "public/apple-touch-icon.png",
        "public/favicon.ico",
        "public/favicon.svg",
        "public/og-image.png",
        "public/skyline/**",
        "public/worker.js",
        "public/sqlite3.wasm",
        "public/sqlite3-licenses.md"
      ]
    }
  }
}
