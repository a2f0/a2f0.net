{
  "name": "resume",
  "version": "0.1.139",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.11.0",
  "engines": {
    "node": "=20.17.0"
  },
  "prettier": {
    "bracketSpacing": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "arrowParens": "avoid"
  },
  "scripts": {
    "start-server": "next dev -p 4000",
    "start-server-test": "next dev -p 4001",
    "test": "NODE_OPTIONS='--experimental-specifier-resolution=node --no-warnings' pnpm wdio run wdio.shared.conf.ts",
    "test-headless": "NODE_OPTIONS='--experimental-specifier-resolution=node --no-warnings' pnpm wdio run wdio.headless.conf.ts",
    "ci": "start-server-and-test start-server-test http-get://localhost:4001 test",
    "ci-headless": "start-server-and-test start-server-test http-get://localhost:4001 test-headless",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint",
    "compile": "tsc",
    "fix": "biome . --fix",
    "prepare": "pnpm compile",
    "unit": "vitest --no-watch --environment jsdom"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.5.1",
    "color": "5.0.0",
    "eslint-config-next": "15.1.7",
    "invariant": "2.2.4",
    "jspdf": "3.0.1",
    "next": "15.2.4",
    "pdfobject": "2.3.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-redux": "9.2.0",
    "redux": "5.0.1",
    "styled-components": "6.1.15",
    "wdio-video-reporter": "6.1.1"
  },
  "devDependencies": {
    "@a2f0/check-for-unpinned-dependencies": "1.0.4",
    "@biomejs/biome": "1.9.4",
    "@puppeteer/browsers": "2.7.1",
    "@testing-library/react": "16.2.0",
    "@types/color": "4.2.0",
    "@types/invariant": "2.2.37",
    "@types/mocha": "10.0.10",
    "@types/node": "22.14.0",
    "@types/pdfobject": "2.2.5",
    "@types/react": "19.0.10",
    "@types/react-redux": "7.1.34",
    "@types/styled-components": "5.1.34",
    "@wdio/cli": "9.10.0",
    "@wdio/globals": "9.10.0",
    "@wdio/local-runner": "9.10.0",
    "@wdio/mocha-framework": "9.9.0",
    "@wdio/spec-reporter": "9.9.0",
    "ajv": "8.17.1",
    "canvas": "3.1.0",
    "jsdom": "26.0.0",
    "prettier": "3.5.2",
    "start-server-and-test": "2.0.10",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vercel": "41.2.0",
    "vitest": "3.0.6"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.34.8"
  }
}
