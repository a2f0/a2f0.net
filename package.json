    "test-headless": "pnpm wdio run wdio.headless.conf.ts",
    "ci": "start-server-and-test start-server-test http-get://localhost:4001 test",
    "ci-headless": "start-server-and-test start-server-test http-get://localhost:4001 test-headless",
