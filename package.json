{
  "name": "resume-workspace",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "serialize-javascript": "7.1.2",
    "smol-toml": "1.9.1"
  },
  "trustedDependencies": [
    "canvas",
    "esbuild",
    "sharp",
    "workerd"
  ],
  "engines": {
    "node": "=24.22.0"
  },
  "scripts": {
    "start-server": "bun run --cwd packages/resume start-server",
    "start-server-test": "bun run --cwd packages/resume start-server-test",
    "test": "bun run --cwd packages/resume test",
    "test-headless": "bun run --cwd packages/resume test-headless",
    "ci": "bun run --cwd packages/resume ci",
    "ci-headless": "bun run --cwd packages/resume ci-headless",
    "build": "turbo run build",
    "start": "bun run --cwd packages/resume start",
    "lint": "biome lint --error-on-warnings",
    "lint:md": "markdownlint-cli2",
    "check:dependencies": "node --import tsx scripts/checkPinnedDependencies.ts",
    "check:architecture": "bun scripts/checkArchitecture.ts",
    "compile": "bun run compile:scripts && turbo run compile",
    "fix": "biome . --fix",
    "prepare": "husky && bun run compile",
    "unit": "bun test ./scripts/ && turbo run unit",
    "deploy:staging": "bun run --cwd packages/resume deploy:staging",
    "deploy:prod": "bun run --cwd packages/resume deploy:prod",
    "deploy:website": "bun run --cwd packages/website deploy",
    "agent-tool": "agent-tool",
    "agent:run": "agent-tool run",
    "agents:sync": "bun run agent-tool skills install --apply",
    "agents:check": "bun run agent-tool skills check",
    "compile:scripts": "tsc -p tsconfig.scripts.json",
    "preview:staging": "bun run --cwd packages/resume preview:staging",
    "preview:prod": "bun run --cwd packages/resume preview:prod",
    "preview:website": "bun run --cwd packages/website preview"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@swc/core": "1.16.18",
    "@types/bun": "1.4.3",
    "agent-tool": "github:a2f0/agent-tool#f88491371eab5f433cfc86aba8e9aa8bc39243f2",
    "dependency-cruiser": "18.6.0",
    "husky": "9.1.7",
    "jsonc-parser": "3.3.1",
    "knip": "6.41.0",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.23.3",
    "tsx": "4.23.15",
    "turbo": "2.11.9",
    "typescript": "7.0.2"
  },
  "patchedDependencies": {
    "markdownlint@0.41.1": "patches/markdownlint@0.41.1.patch"
  }
}
