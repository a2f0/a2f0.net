{
  "name": "resume",
  "version": "0.1.156",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": "=20.17.0"
  },
  "scripts": {
    "start-server": "next dev -p 4000",
    "start-server-test": "next dev -p 4001",
