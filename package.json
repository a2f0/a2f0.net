{
  "name": "resume",
  "version": "0.1.156",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "=24.21.0"
  },
  "scripts": {
    "start-server": "next dev -p 4000",
    "start-server-test": "wrangler dev --env staging --port 4001 --local",
    "test": "pnpm wdio run wdio.shared.conf.ts",
    "test-headless": "pnpm wdio run wdio.headless.conf.ts",
    "ci": "pnpm build && start-server-and-test start-server-test http-get://localhost:4001 test",
    "ci-headless": "pnpm build && start-server-and-test start-server-test http-get://localhost:4001 test-headless",
    "build": "next build",
    "start": "wrangler dev --env staging --port 4000 --local",
    "lint": "biome lint",
    "lint:md": "markdownlint-cli2",
    "compile": "tsc",
    "fix": "biome . --fix",
    "prepare": "husky && pnpm compile",
    "unit": "vitest run",
    "deploy:staging": "pnpm build && wrangler deploy --env staging",
    "deploy:prod": "pnpm build && wrangler deploy --env prod",
    "agent-tool": "tsx packages/agent-tool/src/index.ts"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.9",
    "@next/third-parties": "16.3.5",
    "@reduxjs/toolkit": "2.12.0",
    "color": "5.0.3",
    "invariant": "2.2.4",
    "jspdf": "4.2.1",
    "next": "16.3.5",
    "pdfobject": "2.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-redux": "9.3.0",
    "redux": "5.0.1",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/invariant": "2.2.37",
    "@types/mocha": "10.0.10",
    "@types/node": "26.5.1",
    "@types/pdfobject": "2.2.5",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@wdio/cli": "9.31.9",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.9",
    "@wdio/mocha-framework": "9.31.9",
    "@wdio/spec-reporter": "9.31.2",
    "ajv": "8.20.0",
    "canvas": "3.2.3",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "knip": "6.35.1",
    "lint-staged": "17.5.1",
    "markdownlint-cli2": "0.23.2",
    "start-server-and-test": "3.0.12",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "wdio-video-reporter": "6.2.0",
    "wrangler": "4.132.0"
  }
}
