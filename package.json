{
  "name": "resume",
  "version": "0.1.156",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": "=20.17.0"
  },
  "scripts": {
    "start-server": "next dev -p 4000",
    "start-server-test": "next dev -p 4001",
    "test": "pnpm wdio run wdio.shared.conf.ts",
    "test-headless": "pnpm wdio run wdio.headless.conf.ts",
    "ci": "start-server-and-test start-server-test http-get://localhost:4001 test",
    "ci-headless": "start-server-and-test start-server-test http-get://localhost:4001 test-headless",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint",
    "compile": "tsc",
    "fix": "biome . --fix",
    "prepare": "pnpm compile",
    "unit": "vitest --no-watch --environment jsdom"
  },
  "dependencies": {
    "@next/third-parties": "16.0.6",
    "@reduxjs/toolkit": "2.10.1",
    "color": "5.0.2",
