{
  "name": "resume-workspace",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "@types/node": "24.19.2"
  },
  "trustedDependencies": [
    "canvas",
    "esbuild",
    "sharp",
    "workerd"
  ],
  "engines": {
    "node": "=24.22.1"
  },
  "scripts": {
    "start-server": "bun run --cwd packages/resume start-server",
    "start-server-test": "bun run --cwd packages/resume start-server-test",
    "test": "bun run --cwd packages/resume test",
    "test-headless": "bun run --cwd packages/resume test-headless",
    "ci": "bun run --cwd packages/resume ci",
    "ci-headless": "bun run --cwd packages/resume ci-headless",
    "ci-headless:staging": "bun run --cwd packages/resume ci-headless:staging",
    "build": "turbo run build",
    "start": "bun run --cwd packages/resume start",
    "lint": "biome lint --error-on-warnings",
    "lint:md": "markdownlint-cli2",
    "check:dependencies": "node --import tsx scripts/checks/checkPinnedDependencies.ts",
    "check:architecture": "bun scripts/checks/checkArchitecture.ts",
    "compile": "bun run compile:scripts && turbo run compile",
    "fix": "biome . --fix",
    "prepare": "bun run hooks:install && bun run compile",
    "unit": "bun test ./scripts/ && turbo run unit",
    "deploy:staging": "bun run --cwd packages/resume deploy:staging",
    "deploy:prod": "bun run --cwd packages/resume deploy:prod",
    "deploy:website": "bun run --cwd packages/website deploy",
    "deploy:demo": "bun run --cwd packages/demo deploy",
    "agent-tool": "agent-tool",
    "agent:run": "agent-tool run",
    "agents:sync": "bun run agent-tool skills install --apply",
    "agents:check": "bun run agent-tool skills check",
    "compile:scripts": "tsc -p tsconfig.scripts.json",
    "preview:staging": "bun run --cwd packages/resume preview:staging",
    "preview:prod": "bun run --cwd packages/resume preview:prod",
    "preview:website": "bun run --cwd packages/website preview",
    "preview:demo": "bun run --cwd packages/demo preview",
    "hooks:install": "agent-tool hooks install --apply",
    "lint:branch-name": "agent-tool branch check",
    "check:fast": "agent-tool run-group scripts/testing/checkFast.json",
    "check": "agent-tool run-group scripts/testing/check.json"
  },
  "devDependencies": {
    "@a2f0/agent-tool": "0.1.21",
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@swc/core": "1.16.18",
    "@types/bun": "1.4.3",
    "dependency-cruiser": "18.7.0",
    "jsonc-parser": "3.3.1",
    "knip": "6.42.1",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.24.0",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "patchedDependencies": {
    "markdownlint@0.42.0": "patches/markdownlint@0.42.0.patch"
  }
}
