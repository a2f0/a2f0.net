    "invariant": "2.2.4",
    "jspdf": "3.0.4",
    "next": "16.0.6",
    "pdfobject": "2.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-redux": "9.2.0",
    "redux": "5.0.1",
    "styled-components": "6.1.19",
    "wdio-video-reporter": "6.2.0"
  },
  "devDependencies": {
    "@a2f0/check-for-unpinned-dependencies": "1.0.4",
