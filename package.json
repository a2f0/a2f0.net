{
  "name": "resume-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "basic-ftp": "5.3.1",
    "serialize-javascript": "7.1.1",
    "smol-toml": "1.8.0"
  },
  "trustedDependencies": [
    "@ffmpeg-installer/darwin-arm64",
    "@ffmpeg-installer/darwin-x64",
    "@ffmpeg-installer/linux-arm64",
    "@ffmpeg-installer/linux-x64",
    "@ffmpeg-installer/win32-x64",
    "canvas",
    "esbuild",
    "sharp",
    "workerd"
  ],
  "engines": {
    "node": "=24.21.0"
  },
  "scripts": {
    "start-server": "bun run --cwd packages/resume start-server",
    "start-server-test": "bun run --cwd packages/resume start-server-test",
    "test": "bun run --cwd packages/resume test",
    "test-headless": "bun run --cwd packages/resume test-headless",
    "ci": "bun run --cwd packages/resume ci",
    "ci-headless": "bun run --cwd packages/resume ci-headless",
    "build": "bun run --cwd packages/resume build",
    "start": "bun run --cwd packages/resume start",
    "lint": "biome lint",
    "lint:md": "markdownlint-cli2",
    "compile": "bun run --cwd packages/shared compile && bun run --cwd packages/resume compile && bun run --cwd packages/agent-tool compile && bun run --cwd packages/website compile",
    "fix": "biome . --fix",
    "prepare": "husky && bun run compile",
    "unit": "bun run --cwd packages/shared unit && bun run --cwd packages/resume unit && bun run --cwd packages/agent-tool test && bun run --cwd packages/website unit",
    "deploy:staging": "bun run --cwd packages/resume deploy:staging",
    "deploy:prod": "bun run --cwd packages/resume deploy:prod",
    "deploy:website": "bun run --cwd packages/website deploy",
    "agent-tool": "tsx packages/agent-tool/src/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "husky": "9.1.7",
    "knip": "6.38.0",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.23.2",
    "tsx": "4.23.13"
  }
}
