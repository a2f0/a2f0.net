{
  "name": "resume",
  "version": "0.1.129",
  "private": true,
  "type": "module",
  "engines": {
    "node": "=20.17.0"
  },
  "prettier": {
    "bracketSpacing": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "arrowParens": "avoid"
  },
  "scripts": {
    "server": "next dev -p 4000",
    "server-test": "next dev -p 4001",
    "test": "npx wdio run wdio.shared.conf.ts",
    "test-headless": "npx wdio run wdio.headless.conf.ts",
    "ci": "start-server-and-test server-test http-get://localhost:4001 test",
    "ci-headless": "start-server-and-test server-test http-get://localhost:4001 test-headless",
    "build": "next build",
    "start": "next start",
    "lint": "npx eslint .",
    "compile": "tsc",
    "fix": "eslint . --fix",
    "prepare": "npm run compile",
    "unit": "vitest --no-watch --environment jsdom"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.10.1",
    "color": "5.0.2",
    "eslint-config-next": "16.0.1",
    "invariant": "2.2.4",
    "jspdf": "3.0.3",
    "next": "16.0.1",
    "pdfobject": "2.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-redux": "9.2.0",
    "redux": "5.0.1",
    "styled-components": "6.1.19",
    "ts-node": "10.9.2",
    "wdio-video-reporter": "6.2.0"
  },
  "devDependencies": {
    "@a2f0/check-for-unpinned-dependencies": "1.0.4",
    "@puppeteer/browsers": "2.10.13",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/color": "4.2.0",
    "@types/invariant": "2.2.37",
    "@types/mocha": "10.0.10",
    "@types/node": "24.10.0",
    "@types/pdfobject": "2.2.5",
    "@types/react": "19.2.2",
    "@types/react-redux": "7.1.34",
    "@types/styled-components": "5.1.35",
    "@typescript-eslint/eslint-plugin": "8.46.3",
    "@wdio/cli": "9.20.0",
    "@wdio/local-runner": "9.20.0",
    "@wdio/mocha-framework": "9.20.0",
    "@wdio/spec-reporter": "9.20.0",
    "canvas": "3.2.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "jsdom": "25.0.1",
    "prettier": "3.6.2",
    "start-server-and-test": "2.1.2",
    "typescript": "5.9.3",
    "vercel": "48.9.0",
    "vitest": "4.0.8",
    "wdio-chromedriver-service": "8.1.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.53.1"
  }
}
