{
  "label": "checkFast",
  "steps": [
    {
      "label": "markdown",
      "command": ["bun", "run", "lint:md"]
    },
    {
      "label": "compile",
      "command": ["bun", "run", "compile"]
    },
    {
      "label": "unit",
      "command": ["bun", "run", "unit"]
    },
    {
      "label": "pre-commit",
      "command": ["sh", "scripts/git/hooks/pre-commit"]
    },
    {
      "label": "push-gate",
      "command": ["bun", "run", "agent-tool", "push-gate", "check"]
    },
    {
      "label": "dependencies",
      "command": ["bun", "run", "check:dependencies"]
    },
    {
      "label": "knip",
      "command": ["bunx", "--no-install", "knip"]
    },
    {
      "label": "architecture",
      "command": ["bun", "run", "check:architecture"]
    },
    {
      "label": "agents",
      "command": ["bun", "run", "agents:check"]
    },
    {
      "label": "audit",
      "command": ["bun", "audit", "--audit-level=critical"]
    }
  ]
}
