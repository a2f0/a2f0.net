{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-09-16",
  "workers_dev": false,
  "preview_urls": false,
  // Terraform owns the custom domains. Always select an explicit environment.
  "assets": {
    "directory": "./out",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "env": {
    "staging": { "name": "resume-staging" },
    "prod": { "name": "resume-prod" }
  }
}
